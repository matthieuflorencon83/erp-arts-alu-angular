{
  "name": "frontend-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "prepare": "cd .. && husky frontend-angular/.husky"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.scss": [
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@ng-select/ng-select": "^20.7.0",
    "@ngrx/signals": "^21.0.1",
    "@primeng/themes": "^21.0.4",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.1.18",
    "bootstrap": "^5.3.8",
    "lucide-angular": "^0.563.0",
    "ngx-skeleton-loader": "^12.0.0",
    "primeng": "^21.1.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.19.0",
    "husky": "^9.1.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.0.8"
  }
}